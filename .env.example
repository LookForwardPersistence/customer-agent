# Copy to .env and fill in. Any OpenAI-compatible provider works.
# Examples:
#   OpenAI:    leave OPENAI_BASE_URL unset, OPENAI_MODEL=gpt-4o-mini
#   DeepSeek:  OPENAI_BASE_URL=https://api.deepseek.com  OPENAI_MODEL=deepseek-chat
#   Moonshot:  OPENAI_BASE_URL=https://api.moonshot.cn/v1  OPENAI_MODEL=moonshot-v1-8k
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# State persistence (optional):
#   sqlite (default) - sessions/tokens/checkpoints durable under .data/
#   memory           - in-process only (tests & evaluation use this)
# PERSISTENCE=sqlite
# SQLITE_PATH=.data/agent_state.db
# CHECKPOINT_DB_PATH=.data/agent_checkpoints.db

# LLM channel circuit breaker (optional):
# request timeout in seconds for every model call (default 60, one retry on
# transient errors; a hung provider degrades to a deterministic reply
# instead of holding the request forever).
# LLM_TIMEOUT_SECONDS=60

# LLM channel circuit breaker (optional):
# request timeout in seconds for every model call (default 60, one retry on
# transient errors; a hung provider degrades to a deterministic reply
# instead of holding the request forever).
# LLM_TIMEOUT_SECONDS=60
